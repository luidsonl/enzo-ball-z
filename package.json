{
  "name": "enzoballz",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma 2D em Rust/WASM com farming de aura",
  "scripts": {
    "build": "bash scripts/build-wasm.sh",
    "build:dev": "cargo build -p enzo-wasm --target wasm32-unknown-unknown && node scripts/test-web.mjs --build-dev --no-browser",
    "dev": "bash scripts/build-wasm.sh && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "sprites": "node scripts/gen-sprites.mjs",
    "sprites:blocks": "node tools/pixel-forge/cli.mjs build blocks",
    "sprites:validate": "node tools/pixel-forge/cli.mjs validate blocks",
    "test": "cargo test -p enzo-core -p enzo-sim",
    "test:ui": "vitest run --config vitest.config.mjs",
    "test:ui:watch": "vitest --config vitest.config.mjs",
    "test:web": "node scripts/test-web.mjs",
    "test:web:static": "node scripts/test-web.mjs --no-browser",
    "poc:vue:build": "vite build --config vite.config.mjs",
    "poc:vue:dev": "vite --config vite.config.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  }
}
